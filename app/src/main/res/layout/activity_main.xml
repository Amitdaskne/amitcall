<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2F2F7"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AMITCALL"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="12dp"/>

        <TextView
            android:id="@+id/numberDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="65dp"
            android:gravity="center"
            android:textSize="30sp"
            android:textColor="#111111"
            android:maxLines="1"
            android:ellipsize="start"/>

        <TextView
            android:id="@+id/backspace"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="DELETE"
            android:textColor="#777777"
            android:textSize="13sp"/>

        <GridLayout
            android:id="@+id/dialerGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false">

            <TextView style="@style/DialKey" android:id="@+id/key1" android:text="1"/>
            <TextView style="@style/DialKey" android:id="@+id/key2" android:text="2"/>
            <TextView style="@style/DialKey" android:id="@+id/key3" android:text="3"/>

            <TextView style="@style/DialKey" android:id="@+id/key4" android:text="4"/>
            <TextView style="@style/DialKey" android:id="@+id/key5" android:text="5"/>
            <TextView style="@style/DialKey" android:id="@+id/key6" android:text="6"/>

            <TextView style="@style/DialKey" android:id="@+id/key7" android:text="7"/>
            <TextView style="@style/DialKey" android:id="@+id/key8" android:text="8"/>
            <TextView style="@style/DialKey" android:id="@+id/key9" android:text="9"/>

            <TextView style="@style/DialKey" android:id="@+id/keyStar" android:text="*"/>
            <TextView style="@style/DialKey" android:id="@+id/key0" android:text="0"/>
            <TextView style="@style/DialKey" android:id="@+id/keyHash" android:text="#"/>

        </GridLayout>

        <TextView
            android:id="@+id/callButton"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="CALL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_call"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</ScrollView>
