<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AMITCALL"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:layout_marginTop="20dp"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/numberDisplay"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:gravity="center"
        android:textSize="30sp"
        android:textColor="#111111"
        android:maxLines="1"
        android:ellipsize="start"/>

    <TextView
        android:id="@+id/backspace"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="DELETE"
        android:textColor="#777777"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true">

        <TextView style="@style/DialKey" android:id="@+id/key1" android:text="1"/>
        <TextView style="@style/DialKey" android:id="@+id/key2" android:text="2"/>
        <TextView style="@style/DialKey" android:id="@+id/key3" android:text="3"/>
        <TextView style="@style/DialKey" android:id="@+id/key4" android:text="4"/>
        <TextView style="@style/DialKey" android:id="@+id/key5" android:text="5"/>
        <TextView style="@style/DialKey" android:id="@+id/key6" android:text="6"/>
        <TextView style="@style/DialKey" android:id="@+id/key7" android:text="7"/>
        <TextView style="@style/DialKey" android:id="@+id/key8" android:text="8"/>
        <TextView style="@style/DialKey" android:id="@+id/key9" android:text="9"/>
        <TextView style="@style/DialKey" android:id="@+id/keyStar" android:text="*"/>
        <TextView style="@style/DialKey" android:id="@+id/key0" android:text="0"/>
        <TextView style="@style/DialKey" android:id="@+id/keyHash" android:text="#"/>

    </GridLayout>

    <TextView
        android:id="@+id/callButton"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:text="CALL"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/bg_call"/>

</LinearLayout>
